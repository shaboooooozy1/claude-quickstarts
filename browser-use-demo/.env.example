# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port Configuration (optional - defaults shown)
VNC_PORT=5900
STREAMLIT_PORT=8501
NOVNC_PORT=6080
HTTP_PORT=8080

# Host interface to publish on. Keep 127.0.0.1 unless you put an authenticating proxy in front of the demo.
BIND_ADDR=127.0.0.1